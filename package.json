{
  "name": "no-series-money",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --disable-warning=ExperimentalWarning --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "review:demo": "node scripts/review-demo.ts",
    "test:production": "node --test scripts/check-production.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "review:intake": "node scripts/review-intake.ts",
    "dev:demo": "MONEY_DEMO=1 next dev",
    "agent:compare": "node scripts/compare-local.ts",
    "verify:agent": "npm run format:check && npm run typecheck && npm test && npm run review:demo",
    "verify:release": "npm run verify:agent && npm run build && npm run test:production",
    "monitor:sources": "node scripts/monitor-sources.ts",
    "discover:sources": "node scripts/discover-sources.ts",
    "archive:tariffs": "node scripts/archive-tariffs.ts",
    "review:tariffs": "node scripts/review-tariffs.ts"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-devanagari": "5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "decimal.js-light": "2.5.1",
    "lucide-react": "0.469.0",
    "next": "15.5.25",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "axe-core": "4.10.3",
    "prettier": "3.6.2",
    "typescript": "5.9.3"
  }
}
